{
  "name": "wemeat",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "bun --filter backend dev",
    "dev:customer": "bun --filter customer-app start",
    "dev:shop": "bun --filter shop-owner-app start",
    "android:customer": "bun --filter customer-app android",
    "android:shop": "bun --filter shop-owner-app android",
    "build": "bun --filter \"*\" build",
    "lint": "bun --filter \"*\" lint",
    "typecheck": "bun --filter \"*\" typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@react-native/codegen": "0.87.1",
    "@react-native/gradle-plugin": "0.87.1",
    "@types/node": "^22.13.5",
    "hermes-compiler": "^250829098.0.19",
    "prettier": "^3.5.1",
    "react-native": "0.87.1",
    "typescript": "^5.7.3"
  }
}
