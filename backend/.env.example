# ==============================================================================
# Backend Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# Copy this file to .env and fill in the required values.

# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# PostgreSQL Database (Prisma)
# Example: postgresql://username:password@localhost:5432/chicken_ordering_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chicken_platform_dev?schema=public

# Authentication & JWT (Placeholders for future Phase 1 Auth)
JWT_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=30d

# Firebase Admin SDK (Placeholders for future Push Notifications / Auth)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Payment Gateway Configuration (Placeholders for future Payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

# Realtime & Socket Configuration (Placeholders for future Realtime Order Tracking)
SOCKET_PORT=5001
SOCKET_CORS_ORIGIN=*

# Logging
LOG_LEVEL=debug
