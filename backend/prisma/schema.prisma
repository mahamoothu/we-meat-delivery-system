// Prisma Schema for WeMeat Platform
// Phase 1 - Initialization & Connectivity Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal initial model to verify PostgreSQL connectivity and Prisma migrations
model HealthRecord {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())

  @@map("health_records")
}
