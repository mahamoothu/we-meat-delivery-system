# ==============================================================================
# Customer App Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# Copy this file to .env and fill in the required values.

# Backend API URL (For Android Emulator use 10.0.2.2, for Physical Device use LAN IP)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api/v1

# Firebase Configuration Placeholders (Future Auth / Push Notifications)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps API Key (Future Location / Address Picker)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Payment Gateway Public Key (Future In-App Checkout)
EXPO_PUBLIC_RAZORPAY_KEY_ID=
EXPO_PUBLIC_PHONEPE_MERCHANT_ID=
