# ==============================================================================
# Shop Owner App Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# Copy this file to .env and fill in the required values.

# Backend API URL (For Android Emulator use 10.0.2.2, for Physical Device use LAN IP)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api/v1

# Firebase Configuration Placeholders (Future Auth / Shop Push Notifications)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Notification Configuration Placeholders
EXPO_PUBLIC_ORDER_NOTIFICATION_CHANNEL_ID=chicken_platform_orders
